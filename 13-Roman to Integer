class Solution {
    public int romanToInt(String s) {
        int total = 0;
        int prevValue = 0;

        // Loop backwards from the last character to the first
        for (int i = s.length() - 1; i >= 0; i--) {
            int currentValue = getValue(s.charAt(i));

            // If a smaller numeral comes before a larger one (like I before V in IV), subtract it
            if (currentValue < prevValue) {
                total -= currentValue;
            } else {
                total += currentValue;
            }

            // Update prevValue for the next character to the left
            prevValue = currentValue;
        }

        return total;
    }

    // Helper method to convert a single Roman character into its integer value
    private int getValue(char c) {
        switch (c) {
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
            default: return 0;
        }
    }
}
